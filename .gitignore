.DS_Store
.idea
node_modules
target
scratch
private
*.iml

# C# / .NET build outputs
screensaver/**/bin/
screensaver/**/obj/
screensaver/**/Deploy/
*.user

# Generated runtime data (refreshed by services)
public/data/weather/current/current-*.json
public/data/earthquakes/

# Claude Code workspace dir (chat history, scratch files) — never belongs in a commit
.claude/

# NGINX configs with real API keys — commit only the .conf templates with placeholders
infra/nginx-caprover-override.local.conf
infra/nginx-caprover-default.local.conf

# Orrery dev build output. Vite writes here when BUILD_AS_ROOT is unset; the production
# cutover writes to ../public/ directly. Either way it's a build artefact, not source.
public/orrery/

# Pre-cutover snapshot of /public/ kept on disk as rollback insurance during the
# v0.1.0 cutover. Never commit — large + redundant with the classic/ subtree.
public.backup/
